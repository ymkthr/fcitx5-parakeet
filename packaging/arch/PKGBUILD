# Local build from the repository: run `makepkg -si` in this directory.
pkgname=fcitx5-voice-ja
pkgver=0.4.0
pkgrel=1
pkgdesc="Offline Japanese and English speech input for fcitx5 using NVIDIA Parakeet"
arch=(x86_64)
url="https://github.com/ymkthr/fcitx5-voice-ja"
# MIT: this project, ONNX Runtime and llama.cpp; Apache-2.0: the bundled sherpa-onnx
# libraries; IPADIC: the dictionary embedded in voice-jad.
license=(MIT Apache-2.0 LicenseRef-IPADIC)
# makepkg's -flto turns ring's C objects (built for lindera's IPADIC download)
# into GCC bitcode that rust-lld cannot link.
options=(!debug !lto)
depends=(fcitx5 pipewire)
makedepends=(cargo clang cmake extra-cmake-modules gettext)
provides=(fcitx5-parakeet)
conflicts=(fcitx5-parakeet)
replaces=(fcitx5-parakeet)

_sherpa_version=1.13.7
_sherpa_archive="sherpa-onnx-v${_sherpa_version}-linux-x64-shared-no-tts"
source=("${_sherpa_archive}.tar.bz2::https://github.com/k2-fsa/sherpa-onnx/releases/download/v${_sherpa_version}/${_sherpa_archive}.tar.bz2")
sha256sums=('e5abe50fae5e25ad6b70bc74b51984ccea77df2571f211833b572fcc0d1c3bef')

build() {
  cmake -S "$startdir/../../fcitx5" -B fcitx-build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build fcitx-build

  # ggml turns every SIMD option off when SOURCE_DATE_EPOCH is set, which
  # makepkg always does; voice-jad checks for these at start-up.
  export GGML_SSE42=ON GGML_AVX=ON GGML_AVX2=ON GGML_BMI2=ON GGML_FMA=ON GGML_F16C=ON
  SHERPA_ONNX_LIB_DIR="$srcdir/$_sherpa_archive/lib" \
  SHERPA_ONNX_RPATH=/usr/lib/voice-jad \
    cargo build --manifest-path "$startdir/../../daemon/Cargo.toml" --release --locked
}

package() {
  DESTDIR="$pkgdir" cmake --install fcitx-build
  install -Dm755 "$startdir/../../daemon/target/release/voice-jad" "$pkgdir/usr/bin/voice-jad"
  install -Dm755 "$startdir/../../daemon/target/release/voice-ja-ctl" "$pkgdir/usr/bin/voice-ja-ctl"
  install -Dm755 "$startdir/../../scripts/download-models.sh" "$pkgdir/usr/bin/voice-jad-download-models"
  install -Dm755 "$startdir/../../scripts/capslock-menu.sh" "$pkgdir/usr/bin/voice-ja-capslock-menu"
  install -Dm755 -t "$pkgdir/usr/lib/voice-jad" "$srcdir/$_sherpa_archive/lib/"*.so
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" "$startdir/../../systemd/voice-jad.service" \
    "$startdir/../../systemd/voice-jad.socket"
  install -Dm644 "$startdir/../../daemon/config.example.toml" \
    "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 "$startdir/../../THIRD_PARTY_NOTICES.md" \
    "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/../../LICENSE-APACHE-2.0" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE-2.0"
  install -Dm644 "$startdir/../../licenses/onnxruntime.LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/onnxruntime.LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    "$startdir/../../licenses/llama.cpp.LICENSE" "$startdir/../../licenses/ipadic.LICENSE" \
    "$startdir/../../licenses/onnxruntime-ThirdPartyNotices.txt" \
    "$startdir/../../licenses/rust-crates.LICENSE"
}
