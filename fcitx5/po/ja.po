#: src/parakeet.h
msgid "Language sent to parakeetd (auto, ja or en)"
msgstr "parakeetd に渡す言語（auto、ja、en）"

#: src/parakeet.h
msgid "parakeetd socket (empty: $XDG_RUNTIME_DIR/parakeetd.sock)"
msgstr "parakeetd のソケット（空欄: $XDG_RUNTIME_DIR/parakeetd.sock）"

#: src/parakeet.h
msgid "Show recording status near the cursor"
msgstr "カーソル付近に録音状態を表示する"

#: src/parakeet.cpp
msgid "parakeetd is not running"
msgstr "parakeetd が起動していません"

